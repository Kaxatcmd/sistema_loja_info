# =============================================================
# Ficheiro de exemplo de variáveis de ambiente
# Copie este ficheiro para .env e preencha com os seus valores:
#   cp .env.example .env
# NUNCA faça commit do ficheiro .env!
# =============================================================

# --- Base de Dados ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=loja_informatica

# --- Segurança ---
# Gere uma chave segura com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=substitua_por_uma_chave_segura_aleatoria

# --- Pool de Conexões (opcional) ---
DB_POOL_SIZE=5

# --- Alertas de Stock ---
# Produtos com stock abaixo deste valor geram alertas no painel admin.
STOCK_MINIMO=5
